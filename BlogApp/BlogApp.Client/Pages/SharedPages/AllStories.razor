@page "/posts/{page:int}"

<div class="col-md-8 main-loop">
    <h4 class="font-weight-bold spanborder"><span>All Stories</span></h4>
    @foreach(var post in blogPosts)
    {
        <div class="mb-5 d-flex justify-content-between main-loop-card">
            <div class="pr-3">
                <h2 class="mb-1 h4 font-weight-bold">
                    <a class="text-dark" href="posts/@post.Slug">@post.Title</a>
                </h2>
                <p class="excerpt">
                    @MarkDownConversion.ConvertMarkdownToHtml(post.Excerpt)
                </p>
                <small class="d-block text-muted">
                    In <span class="catlist">
                        <a class="text-capitalize text-muted smoothscroll" href="posts/@post.Slug">@post.CategoryName</a><span class="sep"></span>
                    </span>
                </small>
                <small class="text-muted">
                    @post.PublishedAt
                </small>
            </div>
            @if(post.Image != null)
            {
                <div class="col-md-3 pr-0 text-right">
                    <a href="@post.Slug">
                        <img class="w-100" src="@post.Image" alt="@post.Title">
                    </a>
                </div>
            }
        </div>
    }

    <div class="mt-5">
        <!-- Pagination links -->
        @if (Page > 1)
        {
            <ul class="pagination">
                <!-- Previous Page Links-->
                @if (currentPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href=$"/posts/{Page - 1}">
                            &laquo; Prev</a>
                        </li>
                }
                else
                {
                    <li class="page-item disabled"><span class="prev page-link">&laquo;</span></li>
                }

                <!-- Page Links-->
                @for (var pagelink = 1; pagelink <= totalPages; pagelink++)
                {
                    @if ( pagelink == Page)
                    {
                        <li class="page-item disabled"><span class="webjeda page-link">@pagelink</span></li>
                    }
                    else
                    {
                        <li class="page-item">
                            <a class="page-link" href=$"/posts/{@pagelink}">
                                @pagelink</a>
                        </li>
                    }
                }

                <!-- Next Page Link-->
                @if (Page < totalPages)
                {
                    <li class="page-item">
                        <a class="page-link" href=$"/posts/{@Page + 1}">
                            Next &raquo;
                            </a></li>
                }
                else
                {
                    <li class="page-item disabled">
                        <span class="next page-link">&raquo;</span>
                    </li>
                }
            </ul>
        }
    </div>
</div>

@code {
    [Parameter]
    public int Page { get; set; }

    private List<BlogPostDto> blogPosts = new();
    private int totalRecords;
    private int currentPage = 1;
    private int pageSize = 5;
    private int totalPages;


    protected override async Task OnInitializedAsync()
    {
        await LoadBlogPosts();
    }

    private async Task LoadBlogPosts()
    {
        var response = await blogPostService.GetBlogPost(currentPage, pageSize);

        if (response != null)
        {
            blogPosts = response.Data.ToList();
            totalRecords = response.TotalRecords;
            totalPages = (int)Math.Ceiling((double)totalRecords / pageSize);
        }
    }

    private async Task GoToPage(int pageNumber)
    {
        currentPage = pageNumber;
        await LoadBlogPosts();
    }


}