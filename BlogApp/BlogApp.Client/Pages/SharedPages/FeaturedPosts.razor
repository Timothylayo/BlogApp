
<h4 class="font-weight-bold spanborder"><span>Featured</span></h4>
<ol class="list-featured">
    @foreach(var post in FeaturedPost){
        <li class="mb-4">
            <span>
                <h6 class="font-weight-bold">
                    <a href="posts/@post.Slug" class="text-dark">@post.Title</a>
                </h6>
                <span class="d-block text-muted">
                    In <span class="catlist">
                        
                            <a class="text-capitalize text-muted smoothscroll" href="/posts/@post.Slug">@post.CategoryName</a><span class="sep"></span>
                        
                    </span>
                </span>
            </span>
        </li>
    }
</ol>

@code {
    public List<BlogPostDto> FeaturedPost { get; set; } = [];


    protected override async Task OnInitializedAsync()
    {
        FeaturedPost = await blogPostService.GetFeaturedBlogPostAsync(5);
    }
}
