@page "/"


<PageTitle>Home</PageTitle>


<div class="container">

    <!-- Begin post excerpts, let's highlight the first 4 posts on top -->
    <div class="row remove-site-content-margin">

        @for (int i = 0; i <= recentPost.Count; i++)
        {
            <!-- latest post -->
            @* {% assign latest_post = site.posts[0] %} *@
            latestPost = recentPost[0];
            @if (latestPost != null) 
            {

                <div class="col-md-6">
                    <div class="card border-0 mb-4 box-shadow">
                        <a href="posts/@latestPost.Slug">
                            <div class="topfirstimage" style="height: 200px; background-size: cover; background-repeat: no-repeat;">
                                @latestPost.Image
                            </div>
                        </a>
                        <div class="card-body px-0 pb-0 d-flex flex-column align-items-start">
                            <h2 class="h4 font-weight-bold">
                                <a class="text-dark" href="posts/@latestPost.Slug">@latestPost.introduction</a>
                            </h2>
                            <p class="excerpt">
                                @* {{ latest_post.excerpt | strip_html | strip_newlines | truncate: 136 }} *@
                                @MarkDownConversion.ConvertMarkdownToHtml(latestPost.Content)

                            </p>
                            <div>
                                <small class="d-block text-muted">
                                    In <span class="catlist">
                                        @* {% for category in latest_post.categories %} *@
                                        <a class="text-capitalize text-muted smoothscroll" href="posts/@latestPost.Slug">@latestPost.CategoryName</a><span class="sep">, </span>
                                        @* {% endfor %} *@
                                    </span>
                                </small>
                                <small class="text-muted">
                                    @* {{ latest_post.date | date: '%b %d, %Y' }} *@
                                    @latestPost.PublishedAt
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="col-md-6">
                <!-- second latest post -->
                @* {%- assign second_post = site.posts[1] -%} *@  
                @secondPost = @recentPost[1]
                <div class="mb-3 d-flex align-items-center">                
                    <div class="col-md-4">
                        <a href="/posts/@secondPost!.Slug">
                            <img class="w-100" src="@secondPost!.Image" alt="@secondPost.Title">
                        </a>
                    </div>             
                    <div>
                        <h2 class="mb-2 h6 font-weight-bold">
                            <a class="text-dark" href="/posts/@secondPost.Slug">@secondPost.Title</a>
                        </h2>
                        <small class="d-block text-muted">
                            In <span class="catlist">
                                <a class="text-capitalize text-muted smoothscroll" href="/posts/@secondPost.Slug">@secondPost.CategoryName</a><span class="sep"></span>
                            </span>                   
                        </small>
                        <small class="text-muted">
                            @secondPost.PublishedAt
                        </small>
                    </div>
                </div>

                <!-- third latest post -->
                @* {%- assign third_post = site.posts[2] -%}*@                
                @thirdPost = @recentPost[2]
                <div class="mb-3 d-flex align-items-center">
                    <div class="col-md-4">
                        <a href="/posts/@thirdPost!.Slug">
                            <img class="w-100" src="@thirdPost.Image" alt="@thirdPost.Title">
                        </a>
                    </div>              
                    <div>
                        <h2 class="mb-2 h6 font-weight-bold">
                            <a class="text-dark" href="/posts/@thirdPost.Slug">@thirdPost.Title</a>
                        </h2>
                        <small class="d-block text-muted">
                            In <span class="catlist">
                                <a class="text-capitalize text-muted smoothscroll" href="/posts/@thirdPost!.Slug">@thirdPost.CategoryName</a><span class="sep"> </span>
                            </span>                   
                        </small>
                        <small class="text-muted">
                            @thirdPost.PublishedAt
                        </small>
                    </div>
                </div>

                <!-- fourth latest post -->
                @* {%- assign fourth_post = site.posts[3] -%}*@   
                @fourthPost = @recentPost[3]
                <div class="mb-3 d-flex align-items-center">                
                    <div class="col-md-4">
                        <a href="/posts/@fourthPost!.Slug">
                            <img class="w-100" src="@fourthPost!.Image" alt="@fourthPost.Title">
                        </a>
                    </div>             
                    <div>
                        <h2 class="mb-2 h6 font-weight-bold">
                            <a class="text-dark" href="/posts/@fourthPost.Slug">@fourthPost.Title</a>
                        </h2>
                        <small class="d-block text-muted">
                            In <span class="catlist">
                                <a class="text-capitalize text-muted smoothscroll" href="/posts/@fourthPost.Slug">@fourthPost.CategoryName</a><span class="sep"></span>
                            </span>                   
                        </small>
                        <small class="text-muted">
                            @fourthPost.PublishedAt
                        </small>
                    </div>
                </div>

            </div>
        }
    </div>

    <!-- Sticky - add sticky tag to the post you want to highlight here - tags: [sticky] -->
    @* {% for post in site.posts %} 
{% if post.tags contains "sticky" %} *@
    @foreach (var post in popularPost)
    {
        <div class="jumbotron jumbotron-fluid jumbotron-home pt-0 pb-0 mt-3 mb-2rem bg-lightblue position-relative">
            <div class="pl-4 pr-0 h-100 tofront">
                <div class="row justify-content-between">
                    <div class="col-md-6 pt-6 pb-6 pr-lg-4 align-self-center">
                        <h1 class="mb-3">@post.Title</h1>
                        <p class="mb-3 lead">
                            @* {{ post.excerpt | strip_html | strip_newlines | truncate: 136 }} *@
                            @MarkDownConversion.ConvertMarkdownToHtml(post.Content)
                        </p>
                        <a href="posts/@post.Slug" class="btn btn-dark">Read More</a>
                    </div>
                    <div class="col-md-6 d-none d-md-block pr-0" style="background-size:cover;background-image:url(@post.Image);">
                    </div>
                </div>
            </div>
        </div>
    }
    @* {% endif %}
{% endfor %} *@





    <!-- Now the rest of the posts with the usual loop but with an offset:4 on the first page so we can skeep the first 4 posts displayed above -->

    <div class="row mt-3">

        <AllStories />

        <div class="col-md-4">
            <FeaturedPosts FeaturedPost="featuredPost" />  
        </div>
    </div>

</div>

@code {
    List<BlogPostDto> blogPostDto { get; set; } = new();
    List<BlogPostDto> featuredPost { get; set; } = new();
    List<BlogPostDto> recentPost { get; set; } = new();
    List<BlogPostDto> popularPost { get; set; } = new();

    private BlogPostDto? latestPost ;
    private BlogPostDto? secondPost ;
    private BlogPostDto? thirdPost ;
    private BlogPostDto? fourthPost ;

    protected override async Task OnInitializedAsync()
    {
        var posts = await Task.WhenAll(
            blogPostService.GetFeaturedBlogPostAsync(5),
            blogPostService.GetPopularBlogPostAsync(3),
            blogPostService.GetRecentBlogPostAsync(5)
        );
        featuredPost = posts[0];
        popularPost = posts[1];
        recentPost = posts[2];

        latestPost = recentPost[0];
        secondPost = recentPost[1];
        thirdPost = recentPost[2];
        fourthPost = recentPost[3];
    }

   

}
