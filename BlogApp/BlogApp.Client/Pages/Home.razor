@page "/"


<PageTitle>Home</PageTitle>


<div class="container">

    <!-- Begin post excerpts, let's highlight the first 4 posts on top -->
    <div class="row remove-site-content-margin">
        <!-- latest post -->
        @* {% assign latest_post = site.posts[0] %} *@

        @if (recentPost != null && recentPost.Count > 0)
        {
            <div class="col-md-6">
                <div class="card border-0 mb-4 box-shadow">
                    <a href="posts/@recentPost[0].Slug">
                        <div class="topfirstimage" style="
                            height: 200px; 
                            background-size: cover; 
                            background-repeat: no-repeat;
                            background-image: url('@recentPost[0].Image')">
                        </div>
                    </a>
                    <div class="card-body px-0 pb-0 d-flex flex-column align-items-start">
                        <h2 class="h4 font-weight-bold">
                            <a class="text-dark" href="posts/@recentPost[0].Slug">@recentPost[0].introduction</a>
                        </h2>
                        <p class="excerpt">
                            @MarkDownConversion.ConvertMarkdownToHtml(recentPost[0].Content)
                        </p>
                        <div>
                            <small class="d-block text-muted">
                                In <span class="catlist">
                                    <a class="text-capitalize text-muted smoothscroll" href="posts/@recentPost[0].Slug">@recentPost[0].CategoryName</a>
                                </span>
                            </small>
                            <small class="text-muted">
                                @* {{ latest_post.date | date: '%b %d, %Y' }} *@
                                @recentPost[0].PublishedAt
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <p>No Posts Available.</p>
        }

        @if (recentPost != null && recentPost.Count > 1)
        {
            <div class="col-md-6">
                <!-- second latest post -->
                @* {%- assign second_post = site.posts[1] -%} *@  
                @for (int i = 1; i < Math.Min(recentPost.Count, 4); i++)
                {
                    <div class="mb-3 d-flex align-items-center">
                        <div class="col-md-4">
                            <a href="/posts/@recentPost[i].Slug">
                                <img class="w-100" src="@recentPost[i].Image" alt="@recentPost[i].Title">
                            </a>
                        </div>
                        <div>
                            <h2 class="mb-2 h6 font-weight-bold">
                                <a class="text-dark" href="/posts/@recentPost[i].Slug">@recentPost[i].Title</a>
                            </h2>
                            <small class="d-block text-muted">
                                In <span class="catlist">
                                    <a class="text-capitalize text-muted smoothscroll" href="/posts/@recentPost[i].Slug">@recentPost[i].CategoryName</a><span class="sep"></span>
                                </span>
                            </small>
                            <small class="text-muted">
                                @recentPost[i].PublishedAt
                            </small>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {

        }
    </div>

    <!-- Sticky - add sticky tag to the post you want to highlight here - tags: [sticky] -->
    @* {% for post in site.posts %} 
{% if post.tags contains "sticky" %} *@
    @foreach (var post in popularPost)
    {
        <div class="jumbotron jumbotron-fluid jumbotron-home pt-0 pb-0 mt-3 mb-2rem bg-lightblue position-relative">
            <div class="pl-4 pr-0 h-100 tofront">
                <div class="row justify-content-between">
                    <div class="col-md-6 pt-6 pb-6 pr-lg-4 align-self-center">
                        <h1 class="mb-3">@post.Title</h1>
                        <p class="mb-3 lead">
                            @* {{ post.excerpt | strip_html | strip_newlines | truncate: 136 }} *@
                            @MarkDownConversion.ConvertMarkdownToHtml(post.Content)
                        </p>
                        <a href="posts/@post.Slug" class="btn btn-dark">Read More</a>
                    </div>
                    <div class="col-md-6 d-none d-md-block pr-0" style="background-size:cover;background-image:url(@post.Image);">
                    </div>
                </div>
            </div>
        </div>
    }
    @* {% endif %}
{% endfor %} *@

    <!-- Now the rest of the posts with the usual loop but with an offset:4 on the first page so we can skeep the first 4 posts displayed above -->

    <div class="row mt-3">

        <AllStories />

        <div class="col-md-4">
            <FeaturedPosts />  
        </div>
    </div>

</div>

@code {
    List<BlogPostDto> blogPostDto { get; set; } = new();
    List<BlogPostDto> recentPost { get; set; } = new();
    List<BlogPostDto> popularPost { get; set; } = new();

    private BlogPostDto? latestPost ;

    protected override async Task OnInitializedAsync()
    {
        popularPost = await blogPostService.GetPopularBlogPostAsync(3);
        recentPost = await blogPostService.GetRecentBlogPostAsync(5);

        // latestPost = recentPost[0];
        // secondPost = recentPost[1];
        // thirdPost = recentPost[2];
        // fourthPost = recentPost[3];
    }

   

}
